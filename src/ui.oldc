#include "ui.h"



static UI* frame_ui_state = NULL;

UI* get_ui() {return frame_ui_state;};

static b32 disable_ui = false;
static u64 disable_time = 0;


f32 inv_lerp_fvec2(fvec2 a, fvec2 b, fvec2 p)
{
	f32 major = fvec2_distance(a,b);	
	f32 minor = fvec2_distance(a,p);	
	return minor / major;
}

f32 project_point_to_line(fvec2 a, fvec2 b, fvec2 p)
{
	fvec2 d = fvec2_sub(b,a);	
	f32 denom = fvec2_magnitude_squared(d);
	if(denom == 0.0f)
	{
		return 0.0f;
	}
	f32 t = ((p.x - a.x) * d.x + (p.y - a.y) * d.y) / denom;
	t = fmax(fmin(t, 1.0), 0.0);
	return t;
}


fvec2 project_point_to_line_lerp(fvec2 a, fvec2 b, fvec2 p)
{
	f32 t = project_point_to_line(a,b,p);

	fvec2 d = fvec2_sub(b,a);

	fvec2 xy = fvec2_add(a, fvec2_scalar_mul(d, t));
	return xy;
}



String* random_string(u64 len, u64* state4, Arena* arena)
{
	static const char* alnum = "aaabcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890";
	char* d = arena_alloc(sizeof(char) * (len+1), arena);
	for(u64 i = 0; i < (len >> 3)+1; i++)
	{
		((u64*)d)[i] = romu_quad64(state4);
	}
	for(u32 i = 0; i < len; i++)
	{
		d[i] = alnum[(d[i] & 63)];
	}
	d[len] = 0;
	String* s = clone_string_from_data(d, len+1, arena);
	return s;
}

// For now every child name under a parent must be unique.

UI_Element* lookup_ui_element_by_name(UI* state, const char* name)
{
	u64 hash = hash_cstring(name);
	UI_Element** map = state->elements_map;
	u64 capacity = array_capacity(map);
	u64 index = hash % capacity;
	u64 i;
	for(i = index; i < capacity; i++)
	{
		if(map[i])
		{
			if(match_cstrings_exact(name, map[i]->name->data))
			{
				goto DONE;
			}
		}
	}
	for(i = 0; i < index; i++)
	{
		if(map[i])
		{
			if(match_cstrings_exact(name, map[i]->name->data))
			{
				goto DONE;
			}
		}
	}

	return 0;
	DONE:
	return map[i];
}


b32 insert_element_at_index(u64 i, UI_Element* element)
{
	UI_Element** map = get_ui()->elements_map;
	if(map[i] == 0)
	{
		map[i] = element;
	}
	else if(compare_strings(element->name, map[i]->name))
	{
		UI_Element* e = map[i];
		while(e->long_name_next)
		{
			e = e->long_name_next;
		}
		e->long_name_next = element;
		return true;
	}
	else
	{
		return false;
	}
	return true;
}

b32 ui_add_element(UI_Element* element)
{
	String* name = element->name;
	u64 hash = hash_cstring(name->data);
	UI_Element** map = get_ui()->elements_map;
	u64 capacity = array_capacity(map);
	u64 index = hash % capacity;
	u64 i;
	for(i = index; i < capacity; i++)
	{
		if(insert_element_at_index(i, element))
		{
			goto DONE;
		}
	}
	for(i = 0; i < index; i++)
	{
		if(insert_element_at_index(i, element))
		{
			goto DONE;
		}
	}
	DONE:
	element->index = array_count(get_ui()->elements_array);
	append_array(UI_Element*, &(get_ui()->elements_array), &element, get_ui()->arena);
	return true;
}

static const f32 color_alpha = 0.995;
static const fvec4 color_white = {0.3, 0.3, 0.3, color_alpha};
static const fvec4 color_hi_white = {0.7, 0.7, 0.7, color_alpha};
static const fvec4 color_green = {0.1, 0.9, 0.1, color_alpha};
static const fvec4 color_red = {0.5, 0.0, 0.0, color_alpha};
static const fvec4 color_black = {0.0, 0.0, 0.0, color_alpha};
static const fvec4 color_hover = {0.05, 0.05, 0.05, color_alpha};
static const fvec4 color_hi_black = {0.001, 0.001, 0.001, color_alpha};

static UI_Theme default_theme = {
	.box = {
		.fill = color_hi_black,			
		.outline = color_white,			
		.text = color_hi_white,			
	},
	.button = {
		.on = color_white,
		.off = color_black,
		.outline = color_white,			
		.hover_add = color_hover,
	},
	.slider = {
		.a = color_red,
		.b = color_green,
		.background = color_black,			
		.outline = color_white,			
		.hover_add = color_hover,
	},
};

void ui_init(Camera2 camera, SimpleFont* font, Arena* arena)
{
	UI* last_frame = frame_ui_state;
	frame_ui_state = arena_alloc(sizeof(UI), arena);
	frame_ui_state->last_frame = last_frame;
	get_ui()->arena = arena;	
	{
		UI_Element* root = arena_alloc(sizeof(UI_Element), get_ui()->arena);
		String* path = clone_string_from_cstring("/", get_ui()->arena);
		*root = (UI_Element){
			.a = fvec2_make(0,0),
			.b = camera.frame_size,
			.name = path,
			.type = UI_BOX,
			.data = 0,
		};

		get_ui()->root_element = root;
		u32 max_box_count = 1024 * 1;
		get_ui()->elements_map = allocate_array(UI_Element*, max_box_count * 2, get_ui()->arena);
		get_ui()->elements_array = allocate_array(UI_Element*, max_box_count, get_ui()->arena);
		get_ui()->corner_radius = 8;
		get_ui()->corner_quality = 4;
		get_ui()->border_thickness = 1;
		get_ui()->glyph_height = 12;
		get_ui()->theme = default_theme;
		get_ui()->font = font;
		seed_rng(3456345654, 4, get_ui()->random_state4);
		memzero(get_ui()->elements_map, sizeof(UI_Element*) *  array_capacity(get_ui()->elements_map));
		memzero(get_ui()->elements_map, sizeof(UI_Element*) *  array_capacity(get_ui()->elements_array));

		ui_add_element(root);
	}
}




UI_Element* ui_element(UI_Element *parent, const char* name, fvec2 a, fvec2 b, UI_Type type, void* data);
UI_Button* ui_button(UI_ButtonType type, UI_ButtonTheme* theme);

void ui_element_set_type(UI_Element* element, UI_Type type, void* data)
{
	if(data)
	{
		element->type = type;
		element->data = data;
		switch(type)
		{
			case UI_BOX: {
				UI_Box* box = data; 
				box->element = element;
				if(box->theme == 0){box->theme = &get_ui()->theme.box;}
			}break;
			case UI_BUTTON: {
				UI_Button* button = data; 
				button->element = element;
				if(button->theme == 0){button->theme = &get_ui()->theme.button;}
				if(element->last_frame)
				{
					UI_Button* last_button = element->last_frame->data;
					button->press[0] = last_button->press[0];
				}

			}break;
			case UI_SLIDER: {
				UI_Slider* slider = data; 
				slider->element = element;
				if(slider->theme == 0){slider->theme = &get_ui()->theme.slider;}
				fvec2 button_size = fvec2_sub(element->b, element->a);
				

				// Only Horizontal for now.
				button_size.x = fmin(button_size.x * 0.5, button_size.y);

				fvec2 half_button = fvec2_scalar_mul(button_size, 0.5);
				f32 m = (element->a.y + element->b.y) * 0.5f;
				slider->a = fvec2_make(element->a.x + half_button.x, m);
				slider->b = fvec2_make(element->b.x - half_button.x, m);

				if(slider->element->last_frame)
				{
					UI_Slider* last_frame = slider->element->last_frame->data;
					slider->t[0] = last_frame->t[0];

				}
				slider->p = fvec2_lerp(slider->a, slider->b, slider->t[0]);
				slider->button = ui_button(0,0);
				UI_Element* ele = ui_element(0, 0, 
					fvec2_sub(slider->p, half_button), fvec2_add(slider->p, half_button), 
				UI_BUTTON, slider->button);


			}break;
			default:
			case UI_EMPTY:
				element->data = 0;
				element->data = UI_EMPTY;
			break;
		}
	}
	else
	{
		element->data = 0;
		element->data = UI_EMPTY;
	}
}

UI_Element* ui_element(UI_Element *parent, const char* name, fvec2 a, fvec2 b, UI_Type type, void* data)
{
	if(parent == 0)
	{
		parent = get_ui()->root_element;
	}


	String* path = 0;
	if(name == 0)
	{
		// Make sure there are no duplicates
		do{
			String* str = random_string(4, get_ui()->random_state4, get_ui()->arena);
			path = extend_string_path(parent->name, str->data, get_ui()->arena);
		}while(lookup_ui_element_by_name(get_ui(), path->data));
	}
	else
	{
		path = extend_string_path(parent->name, name, get_ui()->arena);
	}
	UI_Element* element = arena_alloc(sizeof(UI_Element), get_ui()->arena);
	UI_Element *last_frame = 0;
	if(get_ui()->last_frame)
	{
		last_frame = lookup_ui_element_by_name(get_ui()->last_frame, path->data);
	}
	*element = (UI_Element){
		.a = fvec2_add(parent->a, a),
		.b = fvec2_add(parent->a, b),
		.last_frame = last_frame,
		.name = path,
	};
	ui_element_set_type(element, type, data);
	if(ui_add_element(element) == false)
	{
		DEBUG_ABORT("UI hash map is full\n");
	}
	return element;
}



fvec2 ui_pixel_to_world(const Camera2* camera, fvec2 pos)
{
	fvec2 out = fvec2_mul(pos, fvec2_div(camera->unit_pixel, camera->aspect));
	return out;
}

fvec2 ui_pixel_to_world_offset(const Camera2* camera, fvec2 pos)
{
	fvec2 out = fvec2_sub(
		ui_pixel_to_world(camera, pos),
		fvec2_inv(camera->aspect)
	);
	return out;
}

UI_Box* ui_box(UI_BoxType type, UI_BoxTheme* theme)
{
	UI_Box* box = arena_alloc(sizeof(UI_Box), 0,0,get_ui()->arena);
	*box = (UI_Box){
		.type = type,
		.theme = theme,
		.hover = &box->states[0],
		.press = &box->states[1],
		.glyph_height = get_ui()->glyph_height,
	};
	return box;
}
UI_Button* ui_button(UI_ButtonType type, UI_ButtonTheme* theme)
{
	UI_Button* button = arena_alloc(sizeof(UI_Button), 0,0,get_ui()->arena);
	*button = (UI_Button){
		.type = UI_BUTTON_MONOSTABLE,
		.theme = theme,
		.hover = &button->states[0],
		.press = &button->states[1],
	};
	return button;
}
UI_Slider* ui_slider(UI_SliderType type, UI_SliderTheme* theme)
{
	UI_Slider* slider = arena_alloc(sizeof(UI_Slider), 0,0,get_ui()->arena);
	*slider = (UI_Slider){
		.type = UI_SLIDER_DRAG,
		.theme = theme,
		.t = &slider->state[0],
	};


	return slider;
}

b32 poll_box(FrameEvents fe, UI_Box* box)
{
	fvec2 mouse = fe.norm_mouse;
	f32 padding = 0.0;
	b32 hover = point_vs_rounded_rectangle(mouse, 
		fvec2_scalar_sub(box->element->a, padding), 
		fvec2_scalar_add(box->element->b, padding), 
	fvec2_scalar(get_ui()->corner_radius));
	b32 press = fe.mouse_left.pressed;
	if(hover)
	{
		box->hover[0] = true;
		if(press)
		{
			box->press[0] = true;
		}
		else
		{
			box->press[0] = false;
		}
	}
	else
	{
		box->hover[0] = false;
	}
	return hover;
}


b32 gdraw_box(const Camera2* camera, DeviceVertexBuffer* vb, UI_Box* box)
{
	UI_BoxTheme* theme = box->theme;
	fvec2 a = ui_pixel_to_world_offset(camera, box->element->a);
	fvec2 b = ui_pixel_to_world_offset(camera, box->element->b);
	u32 corner_quality = get_ui()->corner_quality;
	f32 corner_radius = ui_pixel_to_world(camera, fvec2_scalar(get_ui()->corner_radius)).x;
	f32 border_thickness = ui_pixel_to_world(camera, fvec2_scalar(get_ui()->border_thickness)).x;
	switch(box->type)
	{
		case UI_BOX_FILL:
		{
			gdraw_rounded_rectangle(vb, corner_quality, corner_radius, a, b, theme->fill);
		}break;
		case UI_BOX_OUTLINE:
			gdraw_rounded_rectangle(vb, corner_quality, corner_radius, a, b, theme->fill);
		break;
		case UI_BOX_FILL_AND_OUTLINE:
		{
			gdraw_rounded_rectangle(vb, corner_quality, corner_radius, a, b, theme->fill);
			gdraw_rounded_rectangle_outline(vb, corner_quality, corner_radius, border_thickness, a, b, theme->outline);
		}break;
		case UI_BOX_TEXT:
		{
		}break;
	}
	if(box->text)
	{
		f32 glyph_height = ui_pixel_to_world(camera, fvec2_scalar(box->glyph_height)).x;
		a = fvec2_add(a, ui_pixel_to_world(camera, box->text_margin));
		gdraw_simple_text_box(vb, get_ui()->font[0], box->text, theme->text, a, b, a, glyph_height);
	}
	return true;
}

b32 poll_button(FrameEvents fe, UI_Button* button)
{
	fvec2 mouse = fe.norm_mouse;
	f32 padding = 3.0;
	b32 hover = point_vs_rounded_rectangle(mouse, 
		fvec2_scalar_sub(button->element->a, padding), 
		fvec2_scalar_add(button->element->b, padding), 
	fvec2_scalar(get_ui()->corner_radius));
	b32 press = fe.mouse_left.pressed;
	if(hover)
	{
		button->hover[0] = true;
		if(press)
		{
			button->press[0] = true;
		}
		else
		{
			button->press[0] = false;
		}
	}
	else
	{
		if(!press)
		{
			button->press[0] = false;
		}
		button->hover[0] = false;
	}
	return hover;
}

b32 gdraw_button(const Camera2* camera, DeviceVertexBuffer* vb, UI_Button* button)
{
	UI_ButtonTheme* theme = button->theme;
	fvec2 a = ui_pixel_to_world_offset(camera, button->element->a);
	fvec2 b = ui_pixel_to_world_offset(camera, button->element->b);
	u32 corner_quality = get_ui()->corner_quality;
	f32 corner_radius = ui_pixel_to_world(camera, fvec2_scalar(get_ui()->corner_radius)).x;
	corner_radius = ui_pixel_to_world(camera, fvec2_scalar(4.0)).x;
	f32 border_thickness = ui_pixel_to_world(camera, fvec2_scalar(get_ui()->border_thickness)).x;

	fvec4 color = theme->off;
	if(button->press[0] == true)
	{
		color = theme->on;
	}
	if(button->hover[0] == true)
	{
		color = fvec4_add(color, theme->hover_add);
	}


	switch(button->type)
	{
		case UI_BUTTON_MONOSTABLE:
		{
			gdraw_rounded_rectangle(vb, corner_quality, corner_radius, a, b, color);
			gdraw_rounded_rectangle_outline(vb, corner_quality, corner_radius, border_thickness, a, b, theme->outline);
		}break;
		default:
		break;
	}
	return true;
	
	return false;
}

b32 poll_slider(FrameEvents fe, UI_Slider* slider)
{
	fvec2 mouse = fe.norm_mouse;
	fvec2 mouse_delta = fe.norm_mouse_delta;
	f32 padding = 3.0;
	b32 hover = point_vs_rounded_rectangle(mouse, 
		fvec2_scalar_sub(slider->element->a, padding), 
		fvec2_scalar_add(slider->element->b, padding), 
	fvec2_scalar(get_ui()->corner_radius));
	b32 press = fe.mouse_left.pressed;


	UI_Element* last_element = slider->element->last_frame;
	if(slider->button->press[0]){
		f32 t = project_point_to_line(slider->a, slider->b, mouse);
		slider->t[0] = t;

		slider->p = fvec2_lerp(slider->a, slider->b, slider->t[0]);
		{
			UI_Element* be = slider->button->element;
			fvec2 half_button = fvec2_scalar_mul(fvec2_sub(be->b, be->a), 0.5);
			be->a = fvec2_sub(slider->p, half_button);
			be->b = fvec2_add(slider->p, half_button);
		}
	}

	return hover;
}

void gdraw_slider(const Camera2* camera, DeviceVertexBuffer* vb, UI_Slider* slider)
{
	UI_SliderTheme* theme  = slider->theme;
	fvec2 a = ui_pixel_to_world_offset(camera, slider->element->a);
	fvec2 b = ui_pixel_to_world_offset(camera, slider->element->b);
	u32 corner_quality = get_ui()->corner_quality;
	f32 corner_radius = ui_pixel_to_world(camera, fvec2_scalar(get_ui()->corner_radius)).x;
	corner_radius = ui_pixel_to_world(camera, fvec2_scalar(4.0)).x;
	f32 border_thickness = ui_pixel_to_world(camera, fvec2_scalar(get_ui()->border_thickness)).x;
	gdraw_rounded_rectangle(vb, corner_quality, corner_radius, a, b, theme->background);
	gdraw_rounded_rectangle_outline(vb, corner_quality, corner_radius, border_thickness, a, b, theme->outline);
	gdraw_button(camera, vb, slider->button);
}


void gdraw_element(DeviceVertexBuffer* vb, UI_Element* e, const Camera2* camera)
{
	fvec2 a = ui_pixel_to_world_offset(camera, e->a);
	fvec2 b = ui_pixel_to_world_offset(camera, e->b);
	fvec4 color = fvec4_scalar(0.01);
	if(e->type == 0)
	{
		color = fvec4_make(0.3, 0.0, 0.3, 0.1);
		if(e->is_hovering)
		{
			color = fvec4_scalar_add(color, 0.1);
		}
		gdraw_rectangle(vb, a,b, color);
		return;
	}
	switch(e->type)
	{
		case UI_BOX:
		{
			gdraw_box(camera, vb, e->data);
		} break;
		case UI_BUTTON:
		{
			gdraw_button(camera, vb, e->data);
		} break;
		case UI_SLIDER:
		{
			gdraw_slider(camera, vb, e->data);
		} break;
		default:
		break;
	}
}

void gdraw_ui(DeviceVertexBuffer* vb, const Camera2* camera)
{
	for(u64 i = 0; i < array_count(get_ui()->elements_array); i++)
	{
		UI_Element* e  = get_ui()->elements_array[i];
		if(e == get_ui()->root_element)
		{
			continue;
		}
		gdraw_element(vb, e, camera);
	}
}


b32 poll_element(UI_Element* e, FrameEvents fe)
{
	if(point_vs_rectangle(fe.norm_mouse, e->a, e->b))
	{
		e->is_hovering = true;
	}
	b32 hover = false;
	switch(e->type)
	{
		case UI_BOX:
		{
			hover = hover | poll_box(fe, e->data);
		}break;
		case UI_BUTTON:
		{
			hover = hover | poll_button(fe, e->data);
		}break;
		case UI_SLIDER:
		{
			hover = hover |  poll_slider(fe, e->data);
		}break;
		default:
		case UI_EMPTY:
		break;
	}
	return hover;
}

b32 poll_ui(FrameEvents fe)
{
	b32 hover = false;
	for(u64 i = 0; i < array_count(get_ui()->elements_array); i++)
	{
		UI_Element* e  = get_ui()->elements_array[i];
		if(e == get_ui()->root_element)
		{
			continue;
		}
		hover = hover | poll_element(e, fe);
	}
	return hover;
}

b32 make_the_ui(FrameEvents fe, SimpleFont* font, Camera2 camera, Arena* arena)
{
	b32 use_last_frame = true;
	if(fe.u.pressed)
	{
		u64 time = get_time_ns();
		if(time - disable_time > 100000000)
		{
			print("disable\n");
			disable_time = time;
			disable_ui = !disable_ui;
			use_last_frame = false;
		}
	}
	if(disable_ui)
	{
		return false;
	}
	ui_init(camera, font, arena);
	if(use_last_frame == false)
	{
		get_ui()->last_frame = 0;
	}
	u64 start = get_time_ns();
	u64 ut = start % 1000000000;
	f64 t = (f64)ut / 1000000000.0;
	t = sin(t * 6.283) * 10.0;
	UI_Element* e = 0;

	u32 top_margin = 48;
	u32 margin = 16;
	u32 padding = 6;
	u32 width = 20;
	u32 height = 20;
	u32 bcx = 10, bcy = 1;

	fvec2 frame_size = camera.frame_size;
	UI_Element* control_box = ui_element(0, "Controls", 
		fvec2_make(frame_size.x - 350, 10),
		fvec2_make(frame_size.x - 10, 430),
		UI_BOX, ui_box(UI_BOX_FILL_AND_OUTLINE, 0)
	);
	{
		e = ui_element(control_box, 0, fvec2_zero(), fvec2_sub(control_box->b,  control_box->a), UI_BOX, ui_box(UI_BOX_TEXT, 0));
		UI_Box* box = e->data;
		box->glyph_height = 64;
		box->text = "BOIDS!";
		box->text_margin = fvec2_make(72, 0);
		
	}

	UI_Element* data_box = ui_element(0, "Data", 
		fvec2_make(frame_size.x - 350, 446),
		fvec2_make(frame_size.x - 10, 800),
		UI_BOX, ui_box(UI_BOX_FILL_AND_OUTLINE, 0)
	);


	get_ui()->glyph_height = height;

	/*
	u32 yp = bcy * (height + padding) + top_margin;
	{
		e = ui_element(control_box, 0, fvec2_make(margin, yp), fvec2_make(control_box->b.x - control_box->a.x - margin, yp + height), UI_BOX, ui_box(UI_BOX_TEXT, 0));
		UI_Box* box = e->data;
		yp += height + padding;
		
